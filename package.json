{
  "name": "workdk",
  "version": "1.3.0",
  "private": true,
  "description": "一隅：可自定义模块、模板与主题的个人工作台",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test:data && npm run test:ui",
    "test:data": "node --experimental-strip-types --test tests/workspace.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:perf": "node --experimental-strip-types scripts/benchmark.mjs",
    "check": "npm test && npm run test:perf && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "5.1.0"
  }
}
